{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "secrets/**": "deny",
      "credentials/**": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/.ssh/**": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "secrets/**": "deny",
      "credentials/**": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/.ssh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "deny",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git tag*": "ask",
      "git branch*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git restore*": "ask",
      "git stash*": "ask",
      "git remote*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "*--force-with-lease*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git gc --prune*": "deny",
      "git branch -D*": "deny",
      "git push --delete*": "deny",
      "*cat *.env*": "deny",
      "*Get-Content *.env*": "deny",
      "*cat *.pem*": "deny",
      "*Get-Content *.pem*": "deny",
      "*cat *.key*": "deny",
      "*Get-Content *.key*": "deny"
    }
  }
}
