# Normalize EOL for all files that Git considers text files.
# Default line endings
* text=auto eol=lf

# Explicit text formats
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.gltf binary
*.blend binary
*.wav binary
*.ogg binary
*.mp3 binary
